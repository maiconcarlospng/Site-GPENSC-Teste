/* =====================================================================
   styles.css – VISUAL DO SITE GPENSC
   Tipografia: Inter (Geométrica, Neutra, Sem Arredondados)
   ===================================================================== */

@import url("https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap");

/* FORÇA A FONTE INTER EM ABSOLUTAMENTE TODOS OS ELEMENTOS DE TODAS AS ABAS */
*, *::before, *::after,
html, body, p, span, a, div, li, td, th,
h1, h2, h3, h4, h5, h6,
.title, .subtitle, .quarto-title, .quarto-secondary-nav, 
.sidebar, .toc, .breadcrumb, input, button, select, textarea {
  font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif !important;
  -webkit-font-smoothing: antialiased;
}
/* ---------- 1. CORES & BASE ---------- */
:root {
  --gp-verde: #1F4D2B;       /* verde-floresta */
  --gp-folha: #5F9A3E;       /* verde-folha */
  --gp-laranja: #D9731F;     /* laranja: botões */
  --gp-laranja-esc: #B9560F; /* laranja escuro */
  --gp-vermelho: #D43A2F;
  --gp-areia: #F3ECDD;       /* faixas bege */
  --gp-menta: #DCEBD3;       /* faixa da coordenação */
}

html, body { 
  scroll-behavior: smooth; 
  overflow-x: hidden; 
  width: 100%;
}

body, p, span, a, div, li { 
  font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif !important; 
  color: #2b2b2b;
  -webkit-font-smoothing: antialiased;
}

/* ---------- 2. MENU E LOGO (NAVBAR) ---------- */
.faixa-topo, 
div.faixa-topo { 
  display: none !important; 
}

.navbar { 
  background: #fff !important; 
  border-bottom: 0; 
  box-shadow: 0 1px 6px rgba(0,0,0,.08); 
  position: relative; 
  padding: 0.6rem 1.5rem !important;
}

.navbar::after { 
  content: ""; 
  position: absolute; 
  left: 0; 
  right: 0; 
  bottom: 0; 
  height: 4px;
  background: linear-gradient(90deg, var(--gp-folha) 0 33%, var(--gp-laranja) 33% 66%, var(--gp-vermelho) 66%); 
}

/* Texto GPENSC no Menu: Em Negrito Marcante (font-weight: 800) */
.navbar-brand,
.navbar-title,
.navbar-brand span {
  display: flex !important;
  align-items: center;
  gap: 0.65rem;
  color: var(--gp-verde) !important;
  font-family: "Inter", sans-serif !important;
  font-size: 1.4rem !important;
  font-weight: 800 !important; /* Negrito destacado */
  letter-spacing: -0.02em !important;
  text-decoration: none !important;
  margin-right: auto;
}

.navbar-brand img {
  max-height: 38px !important;
  width: auto;
  object-fit: contain;
}

.navbar .navbar-nav { 
  margin-left: auto !important; 
  margin-right: 0 !important; 
  gap: 0.2rem;
}

.navbar .nav-link { 
  color: var(--gp-verde) !important; 
  font-weight: 600 !important; 
  font-size: 0.9rem !important;
  padding: 0.5rem 0.8rem !important;
  font-family: "Inter", sans-serif !important;
}

.navbar .nav-link:hover, 
.navbar .nav-link.active { 
  color: var(--gp-laranja) !important; 
}

.navbar .dropdown-menu { 
  border-top: 3px solid var(--gp-laranja); 
}

/* ---------- 3. TÍTULOS E SUBTÍTULOS (SEM ARREDONDADOS) ---------- */
h1, h2, h3, h4, h5, h6,
main h1, main h2, main h3, main h4, main h5, main h6,
.h1, .h2, .h3, .h4, .h5, .h6 { 
  font-family: "Inter", -apple-system, sans-serif !important; 
  font-weight: 700 !important;
  color: var(--gp-verde); 
  letter-spacing: -0.03em !important;
}

main h2 { 
  text-align: center; 
  margin: 3rem 0 1.5rem; 
  padding-bottom: .9rem; 
  border-bottom: 1px solid #d9d5cb; 
}

main h2::before { 
  content: ""; 
  display: inline-block; 
  width: 1.1em; 
  height: 1.1em; 
  margin-right: .45em;
  vertical-align: -.15em; 
  background: url("img/logo_gpensc.png") center / contain no-repeat; 
}

main h3 { text-align: center; margin: 2rem 0 1rem; }
.titulo-pagina { text-align: center; }
.centro { text-align: center; margin: 1.5rem 0; }

/* Botões */
.btn { 
  font-family: "Inter", sans-serif !important;
  text-transform: uppercase; 
  letter-spacing: .06em !important; 
  font-size: .75rem !important; 
  font-weight: 700 !important;
  border-radius: .25rem; 
  padding: .75rem 1.5rem; 
}

.btn-secondary { background: var(--gp-laranja); border-color: var(--gp-laranja); color: #fff; }
.btn-secondary:hover { background: var(--gp-laranja-esc); border-color: var(--gp-laranja-esc); color: #fff; }
.btn-outline-light { border-color: rgba(255,255,255,0.8); color: #fff; }
.btn-outline-light:hover { background: rgba(255,255,255,0.15); color: #fff; }
.btn-sm { padding: .45rem 1rem; font-size: .7rem; }

/* ---------- 4. HERO (FAIXA VERDE DE DESTAQUE) ---------- */
.hero { 
  position: relative; 
  overflow: hidden; 
  background: var(--gp-verde); 
  color: #fff;
  display: flex; 
  align-items: center; 
  justify-content: center; 
  gap: 2.5rem; 
  padding: 3.5rem 1.5rem; 
  text-align: left;
}

.hero-texto { 
  max-width: 650px; 
}

.hero-logo { 
  height: 150px; 
  width: 150px; 
  background: #ffffff; 
  border-radius: 50%; 
  padding: .75rem; 
  object-fit: contain;
  order: -1;
  flex-shrink: 0;
  box-shadow: 0 6px 18px rgba(0,0,0,.25);
}

.hero-sigla { 
  font-family: "Inter", sans-serif !important; 
  font-size: 3.2rem !important; 
  font-weight: 800 !important; 
  letter-spacing: -0.03em !important; 
  display: block; 
  line-height: 1; 
  margin-bottom: .5rem; 
}

.hero-titulo { 
  font-family: "Inter", sans-serif !important;
  font-weight: 700 !important;
  font-size: 1.5rem !important; 
  max-width: 32rem; 
  line-height: 1.25; 
  letter-spacing: -0.02em !important;
}

.hero-inst { opacity: .85; margin-top: .4rem; font-size: .95rem; }
.hero-resumo { margin-top: .8rem; font-size: 1rem; opacity: .95; line-height: 1.5; }
.hero-botoes { margin-top: 1.5rem; display: flex; gap: 1rem; flex-wrap: wrap; }

@media (max-width: 768px) { 
  .hero { flex-direction: column; text-align: center; } 
  .hero-logo { order: 0; margin-bottom: 1rem; }
  .hero-botoes { justify-content: center; }
}

/* ---------- 5. CARTÕES DE PESQUISA & NOTÍCIAS ---------- */
.pq-blocos { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1.25rem; margin: 2rem 0 1rem; }
.pq { 
  position: relative; display: flex; align-items: flex-end; min-height: 280px; border-radius: .4rem; overflow: hidden;
  background-size: cover; background-position: center; box-shadow: 0 4px 14px rgba(0,0,0,.2);
  text-decoration: none !important; transition: transform .2s; 
}
.pq:hover { transform: translateY(-4px); }
.pq-tinta { position: absolute; inset: 0; opacity: .78; }
.pq.cor-1 .pq-tinta { background: var(--gp-verde); }
.pq.cor-2 .pq-tinta { background: var(--gp-laranja); }
.pq.cor-3 .pq-tinta { background: var(--gp-vermelho); }
.pq-titulo { 
  position: relative; z-index: 1; color: #fff; 
  font-family: "Inter", sans-serif !important;
  font-size: 1.5rem !important; font-weight: 700 !important; line-height: 1.15; padding: 1.25rem; 
  letter-spacing: -0.02em !important;
}

.cartoes { display: grid; grid-template-columns: repeat(auto-fill, minmax(290px, 1fr)); gap: 1.5rem; margin: 1.5rem 0; }
.nt { background: #fff; border-radius: .35rem; overflow: hidden; box-shadow: 0 2px 10px rgba(0,0,0,.14); display: flex; flex-direction: column; }
.nt-img { position: relative; height: 190px; background-size: cover; background-position: center; background-color: var(--gp-verde); }
.nt.cor-2 .nt-img { background-color: var(--gp-laranja); }
.nt.cor-3 .nt-img { background-color: var(--gp-vermelho); }
.nt-corpo { padding: 2rem 1.25rem 1rem; flex: 1; }
.nt-corpo h4 { 
  font-family: "Inter", sans-serif !important;
  font-weight: 700 !important;
  color: var(--gp-laranja-esc); 
  font-size: 1.1rem !important; line-height: 1.35; margin: 0 0 .8rem; 
  letter-spacing: -0.01em !important;
}
.nt-data { background: #f6f4ef; color: #8a867c; font-size: .8rem; padding: .7rem 1.25rem; }

/* ---------- 6. FAIXA DA AGENDA (GARANTINDO INTER CORRETA) ---------- */
.faixa-agenda { 
  background: var(--gp-areia); 
  text-align: center; 
  padding: 3.5rem 1.5rem; 
  margin-top: 3rem; 
}

.faixa-agenda h2 { 
  font-family: "Inter", sans-serif !important;
  font-weight: 700 !important;
  font-size: 1.6rem !important;
  letter-spacing: -0.03em !important;
  border: 0 !important; 
  margin: 0 auto 1.5rem !important; 
  max-width: 850px; 
  line-height: 1.3;
}

.faixa-agenda h2::before { display: none !important; }

.faixa { 
  background: #fff; 
  border: 1px solid #e6dfd0; 
  border-left: 6px solid var(--gp-laranja); 
  border-radius: .4rem; 
  padding: 1rem 1.25rem; 
  margin: 1.5rem 0; 
}

.coords-band { background: var(--gp-menta); padding: 1rem 0 3rem; margin: 2.5rem 0; }

.cartao { background: #fff; border: 1px solid #e6dfd0; border-top: 5px solid var(--gp-verde); border-radius: .4rem; padding: 1.25rem; }
.cartao.cor-2 { border-top-color: var(--gp-laranja); }
.cartao.cor-3 { border-top-color: var(--gp-vermelho); }
.cartao-num { font-family: "Inter", sans-serif !important; font-weight: 800 !important; color: var(--gp-laranja-esc); }

.pesq h5 { font-family: "Inter", sans-serif !important; font-weight: 700 !important; font-size: 1rem; margin: .8rem 0 .2rem; color: #222; }
.avatar { display: grid; place-items: center; background: var(--gp-verde); color: #fff; font-family: "Inter", sans-serif !important; font-size: 1.8rem; font-weight: 800 !important; }

.tl-ano { font-family: "Inter", sans-serif !important; font-size: 1.4rem !important; font-weight: 800 !important; color: var(--gp-verde); }

