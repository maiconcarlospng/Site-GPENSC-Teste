/* ---------- 7. ESTRUTURA GLOBAL E MARGENS DIFERENCIADAS ---------- */

/* 1. Reset estrutural de largura para todo o site */
html, body, 
#quarto-content, 
.page-columns, 
main.content, 
#quarto-document-content,
.quarto-container {
  margin: 0 !important;
  padding: 0 !important;
  width: 100% !important;
  max-width: 100% !important;
  overflow-x: hidden !important;
}

/* 2. PÁGINAS INTERNAS (Sobre, Notícias, Projetos, Contato, etc.):
      Aplica a borda/respiro lateral de 2.5rem para o texto não encostar na borda da tela */
body:not(.page-index) main.content,
body:not(.page-index) .secao,
body:not(.page-index) .column-page,
body:not(.page-index) #quarto-document-content {
  max-width: 1200px !important;
  margin-left: auto !important;
  margin-right: auto !important;
  padding-left: 2.5rem !important;
  padding-right: 2.5rem !important;
  padding-top: 2rem !important;
  padding-bottom: 3rem !important;
  box-sizing: border-box !important;
}

/* 3. PÁGINA INICIAL (index.qmd):
      Mantém o layout limpo e o encaixe perfeito das faixas de ponta a ponta */
body.page-index .secao {
  max-width: 1200px !important;
  margin-left: auto !important;
  margin-right: auto !important;
  padding-left: 1.5rem !important;
  padding-right: 1.5rem !important;
  box-sizing: border-box !important;
}

/* 4. Faixas de tela cheia (Hero, Agenda, Coordenação) na Home */
.hero, 
.faixa-agenda, 
.coords-band, 
.column-screen {
  width: 100vw !important;
  position: relative !important;
  left: 50% !important;
  right: 50% !important;
