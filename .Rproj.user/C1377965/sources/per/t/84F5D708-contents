/*-- scss:defaults --*/
/* =====================================================================
   custom.scss – CORES E FONTES DO TEMA (Bootstrap/Quarto)
   ===================================================================== */

@import url("https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap");

// Paleta GPENSC
$primary:    #1F4D2B;   // verde-floresta
$secondary:  #D9731F;   // laranja
$success:    #5F9A3E;   // verde-folha
$danger:     #D43A2F;   // vermelho
$body-bg:    #FFFFFF;
$body-color: #2B2A26;
$link-color: #1F4D2B;

// Define a fonte Inter para TUDO (Corpo do texto, Títulos e Componentes do Quarto)
$font-family-sans-serif: "Inter", -apple-system, BlinkMacSystemFont, sans-serif !default;
$font-family-base:       "Inter", -apple-system, BlinkMacSystemFont, sans-serif !default;
$headings-font-family:   "Inter", -apple-system, BlinkMacSystemFont, sans-serif !default;
$headings-font-weight:   700 !default;
$headings-color:         #1F4D2B !default;

// Barra de menu BRANCA
$navbar-bg: #FFFFFF;
$navbar-fg: #1F4D2B;
$navbar-hl: #D9731F;

/*-- scss:rules --*/